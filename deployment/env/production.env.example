# =====================================================================
# UdyamSetu production environment (EXAMPLE: placeholders only)
# =====================================================================
# Copy each section into its own file, then replace every placeholder:
#   env/mysql.env    <- the MYSQL section
#   env/backend.env  <- the BACKEND section
#
# The real env/*.env files are gitignored. Never commit them, never bake them into an image,
# and never paste real values into this example.
# =====================================================================

# ---------- MYSQL (env/mysql.env) ----------
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD

# ---------- BACKEND (env/backend.env) ----------
# Application database account (created with db/setup/create_app_user.sql.example). Never root.
DB_USERNAME=udyamsetu_app
DB_PASSWORD=REPLACE_WITH_APP_DB_PASSWORD

# Owner sign-in. The hash is a BCrypt hash generated outside this repository.
APP_OWNER_USERNAME=REPLACE_WITH_OWNER_USERNAME
APP_OWNER_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# Exact browser origin, HTTPS, no trailing slash. Example shape: https://app.example.com
APP_ALLOWED_ORIGIN=https://REPLACE_WITH_PUBLIC_DOMAIN

# Business mailbox used for contact messages (SMTP over implicit TLS, configured in application-prod.yaml)
APP_MAIL_USERNAME=REPLACE_WITH_MAILBOX_ADDRESS
APP_MAIL_PASSWORD=REPLACE_WITH_MAILBOX_PASSWORD
